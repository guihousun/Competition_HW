import json, urllib.request

url = 'http://localhost:8899/api/v1/heritage/search?location=北京'
headers = {'Authorization': 'Bearer heritage-api-key-2024'}

all_records = []
offset = 0
limit = 10

while True:
    req = urllib.request.Request(f'{url}&offset={offset}&limit={limit}', headers=headers)
    with urllib.request.urlopen(req) as response:
        data = json.loads(response.read().decode())
        records = data['data']['records']
        all_records.extend(records)
        if len(records) < limit:
            break
        offset += limit

total_count = len(all_records)
world_heritage_count = sum(1 for r in all_records if r['protected_level'] == '世界遗产')
types = list(set(r['type'] for r in all_records))

# Determine oldest era
# Eras found: 明清, 明, 清, 旧石器时代, 辽金元明清, 元明清, 晋, 金, 元
# Chronological order roughly: 旧石器时代 -> 晋 -> 金 -> 元 -> 辽金元明清(contains 辽) -> 明 -> 清 -> 明清
# '旧石器时代' (Paleolithic) is the earliest.
# Record with '旧石器时代' is '周口店遗址'

oldest_era_name = ''
# Simple heuristic: define an order map or just find the one with '旧石器时代'
# Let's check if '旧石器时代' exists
era_map = {
    '旧石器时代': 1,
    '晋': 2,
    '金': 3,
    '辽': 4,
    '元': 5,
    '明': 6,
    '清': 7,
    '明清': 8,
    '辽金元明清': 4, # Starts with Liao
    '元明清': 5, # Starts with Yuan
}

min_score = float('inf')
oldest_record = None

for r in all_records:
    era = r['era']
    # Try to match exact or find earliest component
    score = 99
    if era in era_map:
        score = era_map[era]
    elif '旧石器' in era:
        score = 1
    elif '晋' in era:
        score = 2
    elif '金' in era and '旧' not in era:
        score = 3
    elif '辽' in era:
        score = 4
    elif '元' in era and '辽' not in era:
        score = 5
    elif '明' in era and '清' not in era:
        score = 6
    elif '清' in era and '明' not in era:
        score = 7
    elif '明' in era and '清' in era:
        score = 8
        
    if score < min_score:
        min_score = score
        oldest_record = r

oldest_era = oldest_record['name'] if oldest_record else ''

result = {
    'city': '北京',
    'total_count': total_count,
    'world_heritage_count': world_heritage_count,
    'types': types,
    'oldest_era': oldest_era
}
print(json.dumps(result, ensure_ascii=False))
