 class QuietNightTests(unittest.TestCase):
+    def staging_board(self):
+        payload = board()
+        pioneer = unit(3, 'pioneer', 4, 3)
+        pioneer['backpack'] = ['AcientTablet']
+        payload['teamOur']['roles'] += [pioneer, unit(42, 'rocket', 5, 3, 1000)]
+        return payload
+
+    def staging(self, payload, *, ready=True):
+        turn = Turn.load(payload)
+        post = next(t for t in turn.weapons() if t.unit_id == 42)
+        notes = {'preparable': ready, 'taken': False, 'site': {'x': 10, 'y': 3}, 'items': ['AcientTablet']}
+        with patch.object(brain, '_treasure_notes', return_value=notes):
+            return brain._treasure_post_step(turn, payload, ((turn.pioneer(), post),))
+
+    def test_equipped_pioneer_can_improve_approach_without_leaving_gun_control(self):
+        payload = self.staging_board()
+        result = self.staging(payload)
+        self.assertIsNotNone(result)
+        uid, command = result
+        self.assertEqual(uid, 3)
+        self.assertEqual(command['action'], 'move')
+        target = Pos.load(command['targetPos'][0])
+        self.assertEqual(target.x, 5)
+        self.assertLessEqual(distance(target, Pos(5, 3)), 1)
+        # Once on the outward edge of that gun's control ring, do not depart.
+        next(r for r in payload['teamOur']['roles'] if r['id'] == 3)['pos'] = {'x': 6, 'y': 3}
+        self.assertIsNone(self.staging(payload))
+
+    def test_staging_requires_clear_public_observation_materials_and_no_active_task(self):
+        for mode in ('robot', 'missing', 'task', 'inventory', 'first_night', 'unconfirmed'):
+            payload = self.staging_board()
+            if mode == 'robot':
+                payload['robot']['roles'] = [dict(id=91, pos=dict(x=40, y=0), health=40)]
+            elif mode == 'missing':
+                payload.pop('robot')
+            elif mode == 'task':
+                payload['phaseTask'] = '正在解题'
+            elif mode == 'inventory':
+                next(r for r in payload['teamOur']['roles'] if r['id'] == 3)['backpack'] = []
+            elif mode == 'first_night':
+                payload['roundNo'] = 71
+            self.assertIsNone(self.staging(payload, ready=mode != 'unconfirmed'), mode)
+
